{
  "name": "treecare-backend",
  "version": "1.0.0",
  "description": "TreeCare Backend API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "seed": "ts-node src/seed.ts",
    "studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@prisma/client": "^5.3.1",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "axios": "^1.5.0",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1500.0",
    "twilio": "^3.94.2",
    "stripe": "^13.6.0",
    "socket.io": "^4.7.1",
    "redis": "^4.6.10",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.3",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.9",
    "@types/multer": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "prisma": "^5.3.1",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3"
  }
}